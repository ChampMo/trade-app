# secrets — never tracked (tests/test_no_secrets.py enforces this)
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# runtime data: journal, history cache, logs
# `data/*` only matches the one at the root. A journal written anywhere else — a core started from
# ui/ used to create ui/data/ — must never be committable: it holds account numbers and fills, and
# this repository is public.
data/*
!data/.gitkeep
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
logs/*
!logs/.gitkeep
**/logs/*.log
reports/*
!reports/.gitkeep

# node / electron
node_modules/
ui/dist/
ui/release/

# design canvas output (derived, 2.6 MB) — sources live in docs/design/wireframes
docs/design/wireframes/*.html
!docs/design/wireframes/*.dc.html

# editors / os
.vscode/
.idea/
Thumbs.db
.DS_Store
