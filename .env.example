# Copy to .env on the machine that runs the core. Never commit .env.
# The UI never reads this file; secrets stay on the core host.

# --- MT5 (DEMO terminal) ---
# MT5_PATH is the only value you must set. If that terminal is already logged in,
# leave LOGIN/PASSWORD/SERVER empty and the bridge attaches to whatever account it is on.
# Fill all three to pin one account, so the bridge can never silently use the wrong one.
#
# Where to find them (the three describe ONE trading account):
#   MT5_LOGIN     account number. Terminal: File > Login to Trade Account, the Navigator
#                 panel under Accounts, or the broker's welcome email.
#   MT5_SERVER    exact server name, e.g. "MetaQuotes-Demo" or "XMGlobal-Demo 3". Same login
#                 dialog, or the bottom-right status bar. Copy it character for character,
#                 spaces included.
#   MT5_PASSWORD  the trading (master) password. It is never shown in the terminal — it is the
#                 one the broker sent when the account was created. Lost it? Reset it in the
#                 broker's member area (XM), or open a new demo account.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Hard guard. The bridge refuses a REAL account unless this is exactly "true".
# Leave unset on every dev machine and in CI. Set only on the live host, by hand, in Phase 5.
ALLOW_LIVE=false

# --- journal ---
JOURNAL_DB=data/journal.db
MAGIC_BASE=100000

# --- run-time AI (Phase 3) ---
DEEPSEEK_API_KEY=
DEEPSEEK_DAILY_BUDGET_USD=2.0

# --- alerts (Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
